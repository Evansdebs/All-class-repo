rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: get the requesting user's role from the users or teachers collection
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : (exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
            ? get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.role
            : 'Teacher');
    }

    // Helper: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: role checkers
    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'Super Admin';
    }

    function isAdmin() {
      return isAuthenticated() && (getUserRole() == 'Super Admin' || getUserRole() == 'Administrator');
    }

    function isHeadteacher() {
      return isAuthenticated() && (getUserRole() == 'Super Admin' || getUserRole() == 'Administrator' || getUserRole() == 'Headteacher');
    }

    function isTeacher() {
      return isAuthenticated() && getUserRole() in ['Super Admin', 'Administrator', 'Headteacher', 'Class Teacher', 'Teacher'];
    }

    // Helper: check if teacher is assigned to a class
    function isAssignedToClass(classId) {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && classId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedClasses) ||
        (exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) && classId in get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.assignedClasses)
      );
    }

    // Helper: check if teacher is assigned to a subject
    function isAssignedToSubject(subjectId) {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && subjectId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedSubjects) ||
        (exists(/databases/$(database)/documents/teachers/$(request.auth.uid)) && subjectId in get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.assignedSubjects)
      );
    }

    // ──────────────────────────────────────────────────────────────────────────
    // USERS & TEACHERS COLLECTIONS
    // ──────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // TEACHERS COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /teachers/{teacherId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // STUDENTS COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isAdmin() || isTeacher() || isAuthenticated();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // CLASSES COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /classes/{classId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isAuthenticated();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // SUBJECTS COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /subjects/{subjectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isAuthenticated();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // ACADEMIC YEARS COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /academicYears/{yearId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isAuthenticated();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // TERMS COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /terms/{termId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isAuthenticated();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // GRADING SCALES COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /gradingScales/{scaleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isAuthenticated();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // RESULTS COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /results/{resultId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // REPORTS COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if true;
      allow create, update: if isTeacher();
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // SCHOOL SETTINGS
    // ──────────────────────────────────────────────────────────────────────────
    match /schoolSettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /scores/{docId} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // AUDIT LOGS
    // ──────────────────────────────────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isTeacher();
      allow update, delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // LEGACY: schools/{schoolId} sub-collections (backward-compatible)
    // ──────────────────────────────────────────────────────────────────────────
    match /schools/{schoolId}/{collection}/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
